{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIRIKO saved Run supplemental DTO 1.0.0",
  "$ref": "#/$defs/run",
  "$defs": {
    "watch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "entityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "categoryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "beforeDatasetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "afterDatasetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "sourceProfileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "entityId",
        "categoryId",
        "beforeDatasetId",
        "afterDatasetId",
        "sourceProfileId",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "watchId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "status": {
          "enum": [
            "running",
            "complete",
            "failed",
            "partial",
            "interrupted"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "input": {
          "type": "object",
          "properties": {
            "watch": {
              "$ref": "#/$defs/watch"
            }
          },
          "required": [
            "watch"
          ],
          "additionalProperties": false
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "signal-v1.0.0.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "versions": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "schema": {
              "const": "1.0.0"
            }
          },
          "required": [
            "model",
            "prompt",
            "schema"
          ],
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "modelRequests": {
              "type": "integer",
              "minimum": 0
            },
            "toolCalls": {
              "type": "integer",
              "minimum": 0
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "modelRequests",
            "toolCalls",
            "inputTokens",
            "outputTokens"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "watchId",
        "status",
        "createdAt",
        "completedAt",
        "input",
        "signal",
        "errorCode",
        "versions",
        "usage"
      ],
      "additionalProperties": false
    }
  }
}
