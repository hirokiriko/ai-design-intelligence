{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIRIKO saved Run supplemental DTO 2.1.0",
  "$ref": "#/$defs/run",
  "$defs": {
    "watch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "entityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "categoryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "beforeDatasetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "afterDatasetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "sourceProfileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "entityId",
        "categoryId",
        "beforeDatasetId",
        "afterDatasetId",
        "sourceProfileId",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "2.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "watchId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "status": {
          "enum": [
            "running",
            "complete",
            "failed",
            "partial",
            "interrupted"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "input": {
          "type": "object",
          "properties": {
            "watch": {
              "$ref": "#/$defs/watch"
            },
            "context": {
              "type": "object",
              "properties": {
                "dataMode": {
                  "enum": [
                    "fictional",
                    "approved_public"
                  ]
                },
                "entity": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                },
                "category": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "scheme": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 1000
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "id",
                    "scheme",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "beforeDataset": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    },
                    "dataAsOf": {
                      "type": "string",
                      "maxLength": 10
                    },
                    "coverage": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "collection": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/collection"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "dataAsOf",
                    "coverage",
                    "collection"
                  ],
                  "additionalProperties": false
                },
                "afterDataset": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    },
                    "dataAsOf": {
                      "type": "string",
                      "maxLength": 10
                    },
                    "coverage": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "collection": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/collection"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "dataAsOf",
                    "coverage",
                    "collection"
                  ],
                  "additionalProperties": false
                },
                "knownProducts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 120
                      },
                      "model": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 120
                      },
                      "recordIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "maxItems": 10
                      },
                      "evidence": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "name",
                      "model",
                      "recordIds",
                      "evidence"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 20
                }
              },
              "required": [
                "dataMode",
                "entity",
                "category",
                "beforeDataset",
                "afterDataset",
                "knownProducts"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "watch",
            "context"
          ],
          "additionalProperties": false
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "signal-v2.0.0.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "versions": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "schema": {
              "const": "2.1.0"
            }
          },
          "required": [
            "model",
            "prompt",
            "schema"
          ],
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "modelRequests": {
              "type": "integer",
              "minimum": 0
            },
            "toolCalls": {
              "type": "integer",
              "minimum": 0
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "modelRequests",
            "toolCalls",
            "inputTokens",
            "outputTokens"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "watchId",
        "status",
        "createdAt",
        "completedAt",
        "input",
        "signal",
        "errorCode",
        "versions",
        "usage"
      ],
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "retrospective_weekly_reconstruction"
        },
        "commonStartDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "cutoffDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "cutoffBasis": {
          "const": "source_publication_date"
        },
        "reconstructedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceFamilies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          }
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "archiveSetSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceAcquiredFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sourceAcquiredThrough": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "locallyVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "retrospectiveSupplements": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "kind",
        "commonStartDate",
        "cutoffDate",
        "cutoffBasis",
        "reconstructedAt",
        "sourceFamilies",
        "policySha256",
        "archiveSetSha256",
        "sourceAcquiredFrom",
        "sourceAcquiredThrough",
        "locallyVerifiedAt",
        "retrospectiveSupplements",
        "limitations"
      ],
      "additionalProperties": false
    }
  }
}
