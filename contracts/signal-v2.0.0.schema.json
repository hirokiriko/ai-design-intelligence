    "visualObservations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "part": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "status": {
            "enum": [
              "change_candidate",
              "no_change",
              "unknown"
            ]
          },
          "mediaIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 2
          }
