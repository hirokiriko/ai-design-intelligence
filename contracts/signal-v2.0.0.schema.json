          "height": {
            "type": "integer",
            "minimum": 1
          },
          "sourceLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "permission": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "gazetteDate": {
            "type": [
              "string",
              "null"
            ]
