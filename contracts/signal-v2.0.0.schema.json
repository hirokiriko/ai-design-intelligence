            "maxLength": 1500
          },
          "applicationNumber": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1500
          },
          "registrationNumber": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1500
