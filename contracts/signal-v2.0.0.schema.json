          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "role": {
            "enum": [
              "comparisonA",
              "comparisonB"
