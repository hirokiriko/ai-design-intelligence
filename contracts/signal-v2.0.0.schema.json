                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 1500
                }
              },
              "required": [
                "scheme",
                "code",
                "label"
              ],
              "additionalProperties": false
            },
            "maxItems": 20
          },
          "applicationDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "gazetteDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 800
          },
          "articleDescription": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 800
          },
          "quality": {
            "enum": [
              "pass",
              "warning",
              "quarantined"
            ]
          },
          "sourceFields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1500
            },
            "maxItems": 20
          }
