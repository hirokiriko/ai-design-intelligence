{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiriko.invalid/signal/v2.0.0",
  "title": "KIRIKO evidence signal 2.0.0",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "change_detected",
        "no_change",
        "insufficient",
        "comparison_unavailable"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "before": {
          "type": "integer",
          "minimum": 0
        },
        "after": {
          "type": "integer",
          "minimum": 0
        },
        "newlyObserved": {
          "type": "integer",
          "minimum": 0
        },
        "excludedBefore": {
          "type": "integer",
          "minimum": 0
        },
        "excludedAfter": {
          "type": "integer",
          "minimum": 0
        },
        "comparable": {
          "type": "boolean"
        }
      },
      "required": [
        "before",
        "after",
        "newlyObserved",
        "excludedBefore",
        "excludedAfter",
        "comparable"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        }
      },
      "required": [
        "before",
        "after"
