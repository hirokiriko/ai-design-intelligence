    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "relation": {
            "enum": [
              "direct",
              "category",
              "candidate",
              "unrelated_or_conflicting",
