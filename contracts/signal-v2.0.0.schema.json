          "id",
          "url",
          "title",
          "publishedAt",
          "retrievedAt",
          "excerpt",
          "excerptStart",
          "contentHash",
          "retrospective",
          "updatedAt",
          "releaseAt",
          "extractionVersion",
          "bodyHash",
          "extractedChars",
          "modelVisibleChars",
          "truncated"
