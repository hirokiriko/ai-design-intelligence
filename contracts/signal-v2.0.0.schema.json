          "id",
          "recordId",
          "selectionReason",
          "articleName",
          "applicationNumber",
          "registrationNumber",
          "applicant",
          "classifications",
          "applicationDate",
          "gazetteDate",
          "description",
          "articleDescription",
          "quality",
          "sourceFields"
        ],
        "additionalProperties": false
